# Copy to .env (or export in your shell). All optional in development.
PORT=3000
NODE_ENV=development
# REQUIRED in production: long random string  (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d
# SQLite file location (default: ./data/mapifymuj.db)
DB_PATH=./data/mapifymuj.db
# Comma separated origins allowed by CORS (only needed if the frontend is hosted elsewhere, e.g. GitHub Pages)
CORS_ORIGINS=
# Optional: OpenRouteService key for real walking routes on the outdoor map (https://openrouteservice.org)
ORS_API_KEY=
# Campus timezone used for "current class" logic
CAMPUS_TZ=Asia/Kolkata
# First-run admin account (created only if no admin exists)
ADMIN_EMAIL=admin@muj.local
ADMIN_PASSWORD=
